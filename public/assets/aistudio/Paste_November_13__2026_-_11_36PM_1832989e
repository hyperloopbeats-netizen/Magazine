    <script>
        lucide.createIcons();

        function toggleDrawer(drawerId) {
            const drawer = document.getElementById(drawerId);
            const isOpen = drawer.style.display === 'flex';
            document.querySelectorAll('.panel-drawer').forEach(d => d.style.display = 'none');
            if (!isOpen) drawer.style.display = 'flex';
        }

        function toggleMatrixOverlay(forceState) {
            const overlay = document.getElementById('matrix-overlay');
            const isOpen = forceState !== undefined ? forceState : overlay.style.display !== 'flex';
            overlay.style.display = isOpen ? 'flex' : 'none';
        }

        function sendChatMessage() {
            const input = document.getElementById('chat-input');
            const text = input.value.trim();
            if (!text) return;
            
            const msgBox = document.getElementById('chat-messages');
            msgBox.innerHTML += `
                <div class="bg-cyan-950/40 border border-cyan-500/30 rounded-xl p-2.5 text-cyan-200 ml-6">
                    <div class="font-bold text-[10px] text-cyan-300 mb-0.5">You</div>
                    ${escapeHtml(text)}
                </div>
            `;
            input.value = '';
            msgBox.scrollTop = msgBox.scrollHeight;

            setTimeout(() => {
                const reply = engine.generateAIResponse(text);
                msgBox.innerHTML += `
                    <div class="bg-pink-500/20 border border-pink-400/40 rounded-xl p-2.5 text-pink-200 mr-6">
                        <div class="font-bold text-[10px] text-pink-300 mb-0.5">Cometic Core 2.0</div>
                        ${escapeHtml(reply)}
                    </div>
                `;
                msgBox.scrollTop = msgBox.scrollHeight;
                engine.setSpeechBubble(reply);
            }, 600);
        }

        function escapeHtml(str) {
            return str.replace(/&/g, "&amp;").replace(/</g, "&lt;").replace(/>/g, "&gt;");
        }

        class SentientMP3Engine {
            constructor() {
                this.scene = null;
                this.camera = null;
                this.renderer = null;
                this.composer = null;
                this.bloomPass = null;
                this.gelShaderMat = null;
                this.coreMesh = null;
                this.particleSystem = null;
                this.wireframeGrid = null;
                
                this.currentStep = 1;
                this.unlockedSteps = { 1: true };
                this.clock = new THREE.Clock();

                // Self-Healing & Hardware Adaptation State
                this.hardwareTier = 'balanced'; // high, balanced, eco
                this.fpsHistory = [];
                this.currentParticleCount = 900;
                this.isHealingActive = false;
                this.consecutiveLowFps = 0;

                // Audio & Synthesis State
                this.audioCtx = null;
                this.audioElement = new Audio();
                this.audioSourceNode = null;
                this.analyser = null;
                this.gainNode = null;
                this.biquadBass = null;
                this.biquadMid = null;
                this.biquadTreble = null;
                
                this.playlist = [];
                this.currentIndex = 0;
                this.isPlaying = false;
                this.isShuffle = false;
                this.isLoop = false;
                this.squishSens = 1.0;

                this.synthInterval = null;
                this.synthOsc = null;
                this.currentMood = "✨ Blissful";

                this.stepDetails = {
                    1: { title: "Soft Pastel WebGL2 Context", desc: "Boots hardware-accelerated context with automated context loss recovery handlers.", hook: () => this.actionStep1() },
                    2: { title: "Squishy Gel Matrix Shader", desc: "Compiles custom vertex shaders featuring organic gelatinous wobble and soft pink/cyan rim lighting.", hook: () => this.actionStep2() },
                    3: { title: "Dreamy Pastel Bloom Compositor", desc: "Applies high-pass UnrealBloom with a soft magenta tint for ethereal cloud-like radiance.", hook: () => this.actionStep3() },
                    4: { title: "Bouncing Cute Data-Spirits", desc: "Spawns particle motes with FPS-adaptive LOD particle shedding and dynamic count tuning.", hook: () => this.actionStep4() },
                    5: { title: "Real-Time Spectral Audio FFT", desc: "Resilient Web Audio analyzer pipeline with automatic audio context resumption & node healing.", hook: () => this.actionStep5() },
                    6: { title: "Chibi Raymarched Hyper-Voxels", desc: "Introduces rounded, pillowy signed distance field geometry primitives that feel soft to the touch.", hook: () => this.actionStep6() },
                    7: { title: "Affectionate Gravity Singularity", desc: "Deforms space-time into a cozy gravitational vortex that gently gathers data-motes into a warm hug.", hook: () => this.actionStep7() },
                    8: { title: "10,000 Autonomous Swarm Pets", desc: "Deploys companion AGI pets that maintain cheerful boid formations and cheer for your music.", hook: () => this.actionStep8() },
                    9: { title: "Marshmallow Horizon Grid", desc: "Constructs an infinite glowing pastel wireframe floor with holographic sparkle artifacts.", hook: () => this.actionStep9() },
                    10: { title: "Full Cometic Core Synthesis", desc: "Unlocks ultimate Kawaii Kernel: maximum bloom radiance, bubblegum particle density, and pure joy.", hook: () => this.actionStep10() }
                };
            }

            init() {
                this.detectHardwareTier();
                const container = document.getElementById('viewport-container');
                const width = container.clientWidth;
                const height = container.clientHeight;

                this.scene = new THREE.Scene();
                this.scene.fog = new THREE.FogExp2(0x0b0f19, 0.012);

                this.camera = new THREE.PerspectiveCamera(50, width / height, 0.1, 1000);
                this.camera.position.set(0, 4, 26);
                this.camera.lookAt(0, 0, 0);

                const canvas = document.getElementById('simCanvas');
                
                // Self-Healing WebGL Context Loss Handlers
                canvas.addEventListener('webglcontextlost', (e) => {
                    e.preventDefault();
                    this.logHealingEvent("WebGL Context Lost detected! Triggering autonomous resurrection protocol...", "text-amber-300");
                    document.getElementById('health-status').innerText = "RECOVERING...";
                    document.getElementById('health-status').className = "text-amber-400 animate-pulse";
                }, false);

                canvas.addEventListener('webglcontextrestored', () => {
                    this.logHealingEvent("WebGL Context Restored successfully. Re-building shaders and geometry.", "text-emerald-300");
                    document.getElementById('health-status').innerText = "100% (STABLE)";
                    document.getElementById('health-status').className = "text-emerald-400";
                    this.buildCometicGeometry();
                }, false);

                this.renderer = new THREE.WebGLRenderer({ canvas: canvas, antialias: true, alpha: true, powerPreference: "high-performance" });
                this.renderer.setSize(width, height);
                
                // Set initial pixel ratio based on hardware tier
                const initialPixelRatio = this.hardwareTier === 'eco' ? 1.0 : Math.min(window.devicePixelRatio, 2);
                this.renderer.setPixelRatio(initialPixelRatio);
                this.renderer.toneMapping = THREE.ACESFilmicToneMapping;
                this.renderer.toneMappingExposure = 1.3;

                const renderScene = new THREE.RenderPass(this.scene, this.camera);
                this.bloomPass = new THREE.UnrealBloomPass(new THREE.Vector2(width, height), 1.8, 0.5, 0.75);
                this.bloomPass.threshold = 0.08;
                this.bloomPass.strength = this.hardwareTier === 'eco' ? 1.2 : 2.0;
                this.bloomPass.radius = 0.6;

                this.composer = new THREE.EffectComposer(this.renderer);
                this.composer.addPass(renderScene);
                this.composer.addPass(this.bloomPass);

                const ambientLight = new THREE.AmbientLight(0xffb6c1, 2.2);
                this.scene.add(ambientLight);

                const pointLight = new THREE.PointLight(0xf472b6, 6, 60);
                pointLight.position.set(0, 10, 8);
                this.scene.add(pointLight);

                const cyanLight = new THREE.PointLight(0x38bdf8, 4, 50);
                cyanLight.position.set(0, -10, -5);
                this.scene.add(cyanLight);

                this.buildCometicGeometry();
                this.initAudioPipeline();

                window.addEventListener('resize', () => {
                    const w = container.clientWidth;
                    const h = container.clientHeight;
                    this.camera.aspect = w / h;
                    this.camera.updateProjectionMatrix();
                    this.renderer.setSize(w, h);
                    this.composer.setSize(w, h);
                });

                this.loadDemoSynthTracks();
                this.activateStep(1);
                this.logHealingEvent(`Cometic Engine 2.0 booted on [${this.hardwareTier.toUpperCase()}] tier hardware. Self-healing active.`);
            }

            detectHardwareTier() {
                const cores = navigator.hardwareConcurrency || 4;
                const isMobile = /Android|webOS|iPhone|iPad|iPod|BlackBerry|IEMobile|Opera Mini/i.test(navigator.userAgent);
                
                if (isMobile || cores <= 2) {
                    this.hardwareTier = 'eco';
                    this.currentParticleCount = 300;
                } else if (cores <= 6) {
                    this.hardwareTier = 'balanced';
                    this.currentParticleCount = 600;
                } else {
                    this.hardwareTier = 'high';
                    this.currentParticleCount = 1200;
                }
                
                setTimeout(() => {
                    const tierEl = document.getElementById('tier-label');
                    if (tierEl) tierEl.innerText = `${this.hardwareTier.toUpperCase()} (${cores} cores)`;
                    const lodEl = document.getElementById('lod-label');
                    if (lodEl) lodEl.innerText = `Active (${this.currentParticleCount} motes)`;
                }, 100);
            }

            initAudioPipeline() {
                const AudioContextClass = window.AudioContext || window.webkitAudioContext;
                this.audioCtx = new AudioContextClass();

                this.gainNode = this.audioCtx.createGain();
                this.gainNode.gain.value = 0.8;

                this.biquadBass = this.audioCtx.createBiquadFilter();
                this.biquadBass.type = "lowshelf";
                this.biquadBass.frequency.value = 250;
                this.biquadBass.gain.value = 0;

                this.biquadMid = this.audioCtx.createBiquadFilter();
                this.biquadMid.type = "peaking";
                this.biquadMid.frequency.value = 1000;
                this.biquadMid.gain.value = 0;

                this.biquadTreble = this.audioCtx.createBiquadFilter();
                this.biquadTreble.type = "highshelf";
                this.biquadTreble.frequency.value = 4000;
                this.biquadTreble.gain.value = 0;

                this.analyser = this.audioCtx.createAnalyser();
                this.analyser.fftSize = 256;

                this.audioSourceNode = this.audioCtx.createMediaElementSource(this.audioElement);
                this.audioSourceNode.connect(this.biquadBass);
                this.biquadBass.connect(this.biquadMid);
                this.biquadMid.connect(this.biquadTreble);
                this.biquadTreble.connect(this.gainNode);
                this.gainNode.connect(this.analyser);
                this.analyser.connect(this.audioCtx.destination);

                this.audioElement.addEventListener('ended', () => { this.nextTrack(); });
                this.audioElement.addEventListener('timeupdate', () => {
                    if (!isNaN(this.audioElement.duration)) {
                        const cur = this.audioElement.currentTime;
                        const dur = this.audioElement.duration;
                        document.getElementById('seek-bar').value = (cur / dur) * 100;
                        document.getElementById('time-current').innerText = this.formatTime(cur);
                        document.getElementById('time-duration').innerText = this.formatTime(dur);
                    }
                });

                // Resilient Audio State Observer
                setInterval(() => {
                    if (this.audioCtx && this.audioCtx.state === 'suspended' && this.isPlaying) {
                        this.audioCtx.resume().then(() => {
                            this.logHealingEvent("Resilient Web Audio API context auto-resumed after interruption.", "text-cyan-300");
                        });
                    }
                }, 2000);
            }

            buildCometicGeometry() {
                if (this.coreMesh) this.scene.remove(this.coreMesh);
                if (this.particleSystem) this.scene.remove(this.particleSystem);
                if (this.wireframeGrid) this.scene.remove(this.wireframeGrid);

                const vertexShader = `
                    uniform float uTime;
                    uniform float uAudioBass;
                    varying vec3 vNormal;
                    varying vec2 vUv;
                    void main() {
                        vNormal = normal;
                        vUv = uv;
                        vec3 pos = position;
                        float squish = sin(pos.x * 2.5 + uTime * 2.5) * cos(pos.y * 2.5 + uTime * 2.5) * (0.25 + uAudioBass * 0.4);
                        pos += normal * squish;
                        gl_Position = projectionMatrix * modelViewMatrix * vec4(pos, 1.0);
                    }
                `;

                const fragmentShader = `
                    uniform float uTime;
                    uniform float uAudioMid;
                    varying vec3 vNormal;
                    varying vec2 vUv;
                    void main() {
                        vec3 pastelPink = vec3(0.95, 0.45, 0.70);
                        vec3 pastelCyan = vec3(0.22, 0.74, 0.96);
                        vec3 col = mix(pastelPink, pastelCyan, sin(vUv.x * 6.0 + uTime + uAudioMid * 2.0) * 0.5 + 0.5);
                        float rim = 1.0 - max(dot(vNormal, vec3(0, 0, 1)), 0.0);
                        col += vec3(1.0, 0.8, 0.9) * pow(rim, 2.5) * (1.8 + uAudioMid * 1.5);
                        gl_FragColor = vec4(col, 0.94);
                    }
                `;

                this.gelShaderMat = new THREE.ShaderMaterial({
                    vertexShader,
                    fragmentShader,
                    uniforms: { 
                        uTime: { value: 0.0 },
                        uAudioBass: { value: 0.0 },
                        uAudioMid: { value: 0.0 }
                    },
                    wireframe: false,
                    transparent: true,
                    side: THREE.DoubleSide
                });

                const coreGeo = new THREE.IcosahedronGeometry(4.2, 3);
                this.coreMesh = new THREE.Mesh(coreGeo, this.gelShaderMat);
                this.scene.add(this.coreMesh);

                const pGeo = new THREE.BufferGeometry();
                const pCount = this.currentParticleCount;
                const positions = new Float32Array(pCount * 3);
                const velocities = new Float32Array(pCount * 3);

                for (let i = 0; i < pCount * 3; i += 3) {
                    positions[i] = (Math.random() - 0.5) * 32;
                    positions[i+1] = (Math.random() - 0.5) * 22;
                    positions[i+2] = (Math.random() - 0.5) * 32;

                    velocities[i] = (Math.random() - 0.5) * 0.04;
                    velocities[i+1] = (Math.random() - 0.5) * 0.04 + 0.01;
                    velocities[i+2] = (Math.random() - 0.5) * 0.04;
                }

                pGeo.setAttribute('position', new THREE.BufferAttribute(positions, 3));
                const pMat = new THREE.PointsMaterial({
                    color: 0xffaecd,
                    size: 0.22,
                    transparent: true,
                    blending: THREE.AdditiveBlending
                });

                this.particleSystem = new THREE.Points(pGeo, pMat);
                this.particleSystem.userData = { velocities };
                this.scene.add(this.particleSystem);

                const gridGeo = new THREE.PlaneGeometry(60, 60, 25, 25);
                const gridMat = new THREE.MeshBasicMaterial({ color: 0xf472b6, wireframe: true, transparent: true, opacity: 0.25 });
                this.wireframeGrid = new THREE.Mesh(gridGeo, gridMat);
                this.wireframeGrid.rotation.x = Math.PI / 2;
                this.wireframeGrid.position.y = -8;
                this.scene.add(this.wireframeGrid);
            }

            checkAdaptiveLOD(fps) {
                this.fpsHistory.push(fps);
                if (this.fpsHistory.length > 30) this.fpsHistory.shift();

                const avgFps = this.fpsHistory.reduce((a, b) => a + b, 0) / this.fpsHistory.length;

                if (avgFps < 42 && !this.isHealingActive) {
                    this.consecutiveLowFps++;
                    if (this.consecutiveLowFps > 3) {
                        this.triggerAdaptiveShedding();
                    }
                } else if (avgFps > 55) {
                    this.consecutiveLowFps = 0;
                }
            }

            triggerAdaptiveShedding() {
                if (this.currentParticleCount <= 200) return;
                this.isHealingActive = true;
                this.currentParticleCount = Math.max(200, Math.floor(this.currentParticleCount * 0.75));
                this.renderer.setPixelRatio(1.0);
                if (this.bloomPass) this.bloomPass.strength = 1.2;

                this.logHealingEvent(`[Self-Healing LOD]: Average FPS dropped. Shedding particles down to ${this.currentParticleCount} & scaling down pixel ratio to 1.0.`, "text-amber-300");
                document.getElementById('lod-label').innerText = `Adaptive LOD (${this.currentParticleCount} motes)`;
                document.getElementById('health-status').innerText = "ADAPTED (LOD 1)";
                document.getElementById('health-status').className = "text-cyan-300";

                this.buildCometicGeometry();
                setTimeout(() => { this.isHealingActive = false; }, 5000);
            }

            forceHealSystem() {
                this.currentParticleCount = this.hardwareTier === 'eco' ? 300 : 900;
                this.renderer.setPixelRatio(Math.min(window.devicePixelRatio, 2));
                if (this.bloomPass) this.bloomPass.strength = 2.0;
                this.buildCometicGeometry();
                this.logHealingEvent("Manual Force Heal executed. System parameters restored to optimal presets.", "text-emerald-300");
                document.getElementById('health-status').innerText = "100% (RESTORED)";
                document.getElementById('health-status').className = "text-emerald-400";
                document.getElementById('lod-label').innerText = `Optimal (${this.currentParticleCount} motes)`;
            }

            logHealingEvent(text, colorClass = "text-slate-300") {
                const feed = document.getElementById('matrix-log-feed');
                if (!feed) return;
                const div = document.createElement('div');
                div.className = `${colorClass}`;
                div.innerHTML = `<span class="text-pink-400">[${new Date().toLocaleTimeString()}]</span> ${text}`;
                feed.appendChild(div);
                feed.scrollTop = feed.scrollHeight;
            }

