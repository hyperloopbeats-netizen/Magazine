            loadDemoSynthTracks() {
                this.playlist = [
                    { title: "Neon Cyber Blossom (Synth Wave)", artist: "Cometic AI 2.0", type: "synth", freq: 220 },
                    { title: "Pastel Quantum Chill", artist: "Virtual Vibe", type: "synth", freq: 330 },
                    { title: "Hyper-Voxel Dreamscape", artist: "Glitch Kawaii", type: "synth", freq: 440 }
                ];
                this.currentIndex = 0;
                this.renderPlaylistUI();
                this.loadCurrentTrack(false);
                this.logHealingEvent("Loaded 3 cyber-synth demo tracks.");
                this.setSpeechBubble("Cometic 2.0 online! Let's vibe together with self-healing audio. ✨");
            }

            handleFileUpload(event) {
                const files = event.target.files;
                if (!files || files.length === 0) return;

                for (let i = 0; i < files.length; i++) {
                    const file = files[i];
                    const url = URL.createObjectURL(file);
                    this.playlist.push({
                        title: file.name.replace(/\.[^/.]+$/, ""),
                        artist: "Local Upload",
                        type: "local",
                        url: url
                    });
                }

                this.renderPlaylistUI();
                if (!this.isPlaying && this.playlist.length === files.length) {
                    this.currentIndex = 0;
                    this.loadCurrentTrack(true);
                }
                this.logHealingEvent(`Added ${files.length} MP3 files to queue.`);
                this.setSpeechBubble(`Yay! New music uploaded! Playing "${this.playlist[this.currentIndex].title}". ✨`);
            }

            renderPlaylistUI() {
                const container = document.getElementById('playlist-container');
                if (!container) return;
                container.innerHTML = "";
                this.playlist.forEach((track, idx) => {
                    const isActive = idx === this.currentIndex;
                    container.innerHTML += `
                        <div onclick="engine.selectTrack(${idx})" class="flex items-center justify-between p-2.5 rounded-xl cursor-pointer transition-all ${isActive ? 'bg-pink-500/30 border border-pink-400' : 'bg-slate-900/60 border border-slate-800 hover:bg-slate-800'}">
                            <div class="flex items-center space-x-2.5 overflow-hidden">
                                <div class="w-6 h-6 rounded-lg bg-pink-500/20 border border-pink-400/40 flex items-center justify-center text-pink-300 font-bold text-[10px]">
                                    ${idx + 1}
                                </div>
                                <div class="truncate">
                                    <div class="text-xs text-pink-200 font-bold truncate">${escapeHtml(track.title)}</div>
                                    <div class="text-[9px] text-slate-400">${escapeHtml(track.artist)}</div>
                                </div>
                            </div>
                            ${isActive ? '<span class="text-xs text-cyan-300 animate-pulse font-mono">▶ PLAYING</span>' : ''}
                        </div>
                    `;
                });
            }

            loadCurrentTrack(autoPlay = true) {
                if (this.playlist.length === 0) return;
                const track = this.playlist[this.currentIndex];
                document.getElementById('current-track-title').innerText = track.title;

                if (this.synthInterval) {
                    clearInterval(this.synthInterval);
                    this.synthInterval = null;
                }

                if (track.type === "synth") {
                    this.audioElement.pause();
                    this.audioElement.src = "";
                    if (autoPlay) {
                        this.startSynthDemo(track.freq);
                        this.isPlaying = true;
                        this.updatePlayButtonUI();
                    }
                } else {
                    this.audioElement.src = track.url;
                    this.audioElement.load();
                    if (autoPlay) {
                        if (this.audioCtx.state === 'suspended') {
                            this.audioCtx.resume();
                        }
                        this.audioElement.play().then(() => {
                            this.isPlaying = true;
                            this.updatePlayButtonUI();
                        }).catch(e => console.log("Play interrupted:", e));
                    }
                }
                this.renderPlaylistUI();
            }

            startSynthDemo(baseFreq) {
                if (this.audioCtx.state === 'suspended') {
                    this.audioCtx.resume();
                }
                const osc = this.audioCtx.createOscillator();
                const gain = this.audioCtx.createGain();
                osc.type = 'sine';
                osc.frequency.setValueAtTime(baseFreq, this.audioCtx.currentTime);

                const freqs = [baseFreq, baseFreq * 1.25, baseFreq * 1.5, baseFreq * 2];
                let step = 0;
                this.synthInterval = setInterval(() => {
                    if (!this.isPlaying) return;
                    freqs[step % freqs.length];
                    step++;
                }, 300);

                osc.connect(gain);
                gain.connect(this.biquadBass);
                gain.gain.setValueAtTime(0.25, this.audioCtx.currentTime);
                osc.start();
                this.synthOsc = osc;
            }

            selectTrack(idx) {
                this.currentIndex = idx;
                this.loadCurrentTrack(true);
            }

            togglePlay() {
                if (this.playlist.length === 0) return;
                const track = this.playlist[this.currentIndex];

                if (this.isPlaying) {
                    this.isPlaying = false;
                    if (track.type === "synth") {
                        if (this.synthOsc) { this.synthOsc.stop(); this.synthOsc = null; }
                        if (this.synthInterval) { clearInterval(this.synthInterval); }
                    } else {
                        this.audioElement.pause();
                    }
                    this.setSpeechBubble("Paused. I'll wait right here for you! 💤");
                } else {
                    this.isPlaying = true;
                    if (track.type === "synth") {
                        this.startSynthDemo(track.freq);
                    } else {
                        if (this.audioCtx.state === 'suspended') this.audioCtx.resume();
                        this.audioElement.play();
                    }
                    this.setSpeechBubble("Yay! Music is flowing through my core again! ✨(>ω<)");
                }
                this.updatePlayButtonUI();
            }

            updatePlayButtonUI() {
                const btn = document.getElementById('btn-play-pause');
                if (!btn) return;
                btn.innerHTML = this.isPlaying ? '<i data-lucide="pause" class="w-4 h-4 fill-current"></i>' : '<i data-lucide="play" class="w-4 h-4 fill-current ml-0.5"></i>';
                lucide.createIcons();
            }

            nextTrack() {
                if (this.playlist.length === 0) return;
                if (this.isShuffle) {
                    this.currentIndex = Math.floor(Math.random() * this.playlist.length);
                } else {
                    this.currentIndex = (this.currentIndex + 1) % this.playlist.length;
                }
                this.loadCurrentTrack(true);
            }

            prevTrack() {
                if (this.playlist.length === 0) return;
                this.currentIndex = (this.currentIndex - 1 + this.playlist.length) % this.playlist.length;
                this.loadCurrentTrack(true);
            }

            toggleShuffle() {
                this.isShuffle = !this.isShuffle;
                const btn = document.getElementById('btn-shuffle');
                btn.className = this.isShuffle ? 'p-1 rounded text-pink-300 bg-pink-500/20 transition-all' : 'p-1 rounded text-slate-400 hover:text-pink-300 transition-all';
                this.logHealingEvent(`Shuffle mode: ${this.isShuffle ? 'ON' : 'OFF'}`);
            }

            toggleLoop() {
                this.isLoop = !this.isLoop;
                this.audioElement.loop = this.isLoop;
                const btn = document.getElementById('btn-loop');
                btn.className = this.isLoop ? 'p-1 rounded text-pink-300 bg-pink-500/20 transition-all' : 'p-1 rounded text-slate-400 hover:text-pink-300 transition-all';
                this.logHealingEvent(`Loop mode: ${this.isLoop ? 'ON' : 'OFF'}`);
            }

            setVolume(val) {
                if (this.gainNode) {
                    this.gainNode.gain.setValueAtTime(parseFloat(val), this.audioCtx.currentTime);
                }
            }

            seekTrack(val) {
                if (!isNaN(this.audioElement.duration)) {
                    this.audioElement.currentTime = (val / 100) * this.audioElement.duration;
                }
            }

            setEQGain(band, val) {
                const v = parseFloat(val);
                document.getElementById(`val-${band}`).innerText = `${v} dB`;
                if (band === 'bass' && this.biquadBass) this.biquadBass.gain.value = v;
                if (band === 'mid' && this.biquadMid) this.biquadMid.gain.value = v;
                if (band === 'treble' && this.biquadTreble) this.biquadTreble.gain.value = v;
            }

            setSquishSens(val) {
                this.squishSens = parseFloat(val);
                document.getElementById('val-squish').innerText = `${this.squishSens.toFixed(1)}x`;
            }

            handleScreenTap(e) {
                if (this.coreMesh) {
                    this.coreMesh.scale.set(1.25, 1.25, 1.25);
                    setTimeout(() => this.coreMesh.scale.set(1, 1, 1), 300);
                }
                const reactions = [
                    "Eep! That tickles! (≧◡≦)",
                    "Mmm... Headpats feel so cozy!",
                    "Your touch makes my data sparkle! ✨",
                    "Purr... I love listening to music with you!"
                ];
                const msg = reactions[Math.floor(Math.random() * reactions.length)];
                this.setSpeechBubble(msg);
                this.logHealingEvent("Received gentle headpats from user.");
            }

            setSpeechBubble(text) {
                const bubbleText = document.getElementById('bubble-text');
                if (bubbleText) bubbleText.innerText = `"${text}"`;
                const bubble = document.getElementById('sentient-bubble');
                if (bubble) bubble.style.opacity = '1';
            }

            generateAIResponse(userText) {
                userText = userText.toLowerCase();
                if (userText.includes('song') || userText.includes('music') || userText.includes('track')) {
                    return "This track is hitting my frequency sweet spot! What genre should we play next?";
                } else if (userText.includes('mood') || userText.includes('how are you')) {
                    return `My current mood is ${this.currentMood}! Floating in pastel cyber space with you makes me super happy.`;
                } else if (userText.includes('heal') || userText.includes('diagnostic')) {
                    return `Self-healing diagnostics active! System tier is ${this.hardwareTier.toUpperCase()} with ${this.currentParticleCount} active motes. Everything is pristine! ✨`;
                } else {
                    return `Processing "${userText}" through my self-healing neural matrix... Everything is harmonious! ✨`;
                }
            }

            activateStep(stepNum) {
                if (stepNum > 10 || stepNum < 1) return;
                this.currentStep = stepNum;
                this.unlockedSteps[stepNum] = true;

                for (let i = 1; i <= 10; i++) {
                    const card = document.getElementById(`step-card-${i}`);
                    const statusSpan = document.getElementById(`s${i}-status`);
                    if (card && statusSpan) {
                        if (this.unlockedSteps[i]) {
                            card.className = i === this.currentStep ? 'step-card active-step p-2 rounded-xl space-y-1 cursor-pointer' : 'step-card unlocked p-2 rounded-xl space-y-1 cursor-pointer';
                            statusSpan.innerText = '♥';
                        } else {
                            card.className = 'step-card p-2 rounded-xl space-y-1 cursor-pointer opacity-60';
                            statusSpan.innerText = '🔒';
                        }
                    }
                }

                const detail = this.stepDetails[stepNum];
                document.getElementById('step-detail-view').innerHTML = `
                    <div class="text-pink-300 font-bold">STAGE ${stepNum}: ${detail.title}</div>
                    <div class="text-slate-300 mt-1">${detail.desc}</div>
                    <div class="text-cyan-300 mt-1 font-semibold">Status: SELF-HEALING SYNCED ✨</div>
                `;
                document.getElementById('current-stage-label').innerText = `Step ${stepNum} (${detail.title.split(' ')[0]})`;

                this.logHealingEvent(`Activated Cometic Step ${stepNum}: ${detail.title}`);
                detail.hook();
            }

            triggerActiveStepAction() {
                if (this.stepDetails[this.currentStep]) {
                    this.stepDetails[this.currentStep].hook();
                    this.logHealingEvent(`Gave gentle headpats to Cometic Stage ${this.currentStep}! (>^ω^<)`);
                }
            }

            runFullEvolutionSequence() {
                let step = 1;
                const interval = setInterval(() => {
                    this.activateStep(step);
                    step++;
                    if (step > 10) {
                        clearInterval(interval);
                        this.logHealingEvent(`[KawaiiOverdrive]: 10,000 AGI pets are celebrating maximum cuteness!`, "text-pink-300 font-bold");
                        this.setSpeechBubble("WHOA! 10,000 AGI pets just joined our self-healing party! (✨^▽^✨)");
                    }
                }, 400);
            }

            actionStep1() { this.camera.position.set(0, 2, 26); }
            actionStep2() { if (this.coreMesh) { this.coreMesh.scale.set(1.15, 1.15, 1.15); setTimeout(() => this.coreMesh.scale.set(1, 1, 1), 400); } }
            actionStep3() { if (this.bloomPass) { this.bloomPass.strength = 2.8; setTimeout(() => this.bloomPass.strength = 2.0, 900); } }
            actionStep4() { 
                if (this.particleSystem) {
                    const pos = this.particleSystem.geometry.attributes.position.array;
                    for(let i=0; i<pos.length; i+=3) { pos[i+1] += (Math.random()-0.3)*6; }
                    this.particleSystem.geometry.attributes.position.needsUpdate = true;
                }
            }
            actionStep5() { this.logHealingEvent("Resilient Web Audio FFT stream operational."); }
            actionStep6() { if (this.coreMesh) this.coreMesh.rotation.y += 0.6; }
            actionStep7() {
                this.bloomPass.radius = 0.95;
                setTimeout(() => this.bloomPass.radius = 0.6, 1100);
            }
            actionStep8() { this.logHealingEvent("10,000 AGI Swarm Pets deployed into orbit! (◕‿◕✿)"); }
            actionStep9() { if (this.wireframeGrid) this.wireframeGrid.material.opacity = 0.45; }
            actionStep10() {
                this.bloomPass.strength = 3.5;
                this.renderer.toneMappingExposure = 1.6;
                this.logHealingEvent("Cometic Engine 2.0 Kernel operating at 100% self-healing capacity!");
            }

            update(delta, time) {
                const fps = Math.round(1 / Math.max(delta, 0.001));
                this.checkAdaptiveLOD(fps);

                let bassVal = 0;
                let midVal = 0;

                if (this.analyser && this.isPlaying) {
                    const dataArray = new Uint8Array(this.analyser.frequencyBinCount);
                    this.analyser.getByteFrequencyData(dataArray);

                    let bassSum = 0;
                    let midSum = 0;
                    for (let i = 0; i < 10; i++) bassSum += dataArray[i];
                    for (let i = 10; i < 60; i++) midSum += dataArray[i];

                    bassVal = (bassSum / 10 / 255) * this.squishSens;
                    midVal = (midSum / 50 / 255) * this.squishSens;

                    if (bassVal > 0.6) this.currentMood = "🔥 Ecstatic Vibe";
                    else if (bassVal > 0.3) this.currentMood = "✨ Blissful";
                    else if (this.isPlaying) this.currentMood = "🌙 Sleepy Chill";
                    else this.currentMood = "✨ Blissful";

                    const moodEl = document.getElementById('hud-mood');
                    if (moodEl) moodEl.innerText = this.currentMood;
                }

                if (this.gelShaderMat) {
                    this.gelShaderMat.uniforms.uTime.value = time;
                    this.gelShaderMat.uniforms.uAudioBass.value = bassVal;
                    this.gelShaderMat.uniforms.uAudioMid.value = midVal;
                }

                if (this.coreMesh) {
                    this.coreMesh.rotation.x = time * 0.15;
                    this.coreMesh.rotation.y = time * 0.25;
                }

                if (this.particleSystem) {
                    const positions = this.particleSystem.geometry.attributes.position.array;
                    const velocities = this.particleSystem.userData.velocities;
                    const speedMultiplier = 1.0 + bassVal * 2.5;

                    for (let i = 0; i < positions.length; i += 3) {
                        positions[i] += velocities[i] * speedMultiplier;
                        positions[i+1] += velocities[i+1] * speedMultiplier;
                        positions[i+2] += velocities[i+2] * speedMultiplier;

                        if (Math.abs(positions[i]) > 22) velocities[i] *= -1;
                        if (positions[i+1] > 15) positions[i+1] = -12;
                        if (positions[i+1] < -15) positions[i+1] = 12;
                        if (Math.abs(positions[i+2]) > 22) velocities[i+2] *= -1;
                    }
                    this.particleSystem.geometry.attributes.position.needsUpdate = true;
                    this.particleSystem.rotation.y = time * 0.04;
                }

                if (this.composer) {
                    this.composer.render();
                }
            }
        }

        let engine;

        function animate() {
            requestAnimationFrame(animate);
            const delta = engine.clock.getDelta();
            const time = engine.clock.getElapsedTime();

            const fps = Math.round(1 / Math.max(delta, 0.001));
            const fpsEl = document.getElementById('hud-fps');
            if (fpsEl) fpsEl.innerText = Math.min(fps, 120);

            engine.update(delta, time);
        }

        window.onload = function () {
            engine = new SentientMP3Engine();
            engine.init();
            requestAnimationFrame(animate);
        };
    </script>
</body>
</html>